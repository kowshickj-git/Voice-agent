# Settings for the second agent: the phone assistant for Sunbridger, Sungrow's distributor for Tamil Nadu.
# Start it with: npm run start:sungrow   (check it with: npm run doctor:sungrow)
#
# It shares the keys and model settings in .env (DEEPGRAM_API_KEY, LLM_PROVIDER, ...).
# Anything set here wins for this agent only. Its port, name, prompts, records folder,
# and transfer number are never taken from .env, so it can't mix with the dental agent.

# Local port (the main agent uses 8080). Delete this line if a hosting platform sets PORT for you.
PORT=8081

AGENT_NAME=Ava
COMPANY_NAME=Sunbridger
GREETING=Hi, thanks for calling Sunbridger, Sungrow's distributor for Tamil Nadu. This is Ava. How can I help you today?
AGENT_LANGUAGE=English
TIMEZONE=Asia/Kolkata
# Besides the knowledge base, the agent may answer general questions on this subject from its own
# knowledge. Facts about Sunbridger and product specs still come only from knowledge.md.
AGENT_EXPERTISE=solar power and energy storage: panels, inverters, batteries, BESS, and rooftop solar in India and Tamil Nadu

# The solar_estimate tool: works out system size, generation, panels, roof area, subsidy, and the
# matching Sungrow inverter and battery, so the agent never does sizing arithmetic in its head.
SOLAR_ESTIMATOR=on

# A phone number for "let me talk to a person" (E.164 format, e.g. +919800000000).
# Leave empty and the agent takes a message instead.
TRANSFER_NUMBER=
# Optional: POST every message this agent takes to this URL (Slack, Zapier, Make, ...).
MESSAGE_WEBHOOK_URL=

# Ava's voice: bright, clear, and energetic (the deeper male voice aura-2-orpheus-en sounded too low on calls).
# More voices: see .env.example.
DEEPGRAM_VOICE=aura-2-thalia-en
# Words the speech recognizer should expect. Tested on real-time phone audio: without "Sungrow" and
# "Sunbridger" here it hears "sun grown burger" and "Sunburger"; phrases like "Sungrow inverter"
# made recognition worse, so keep single terms.
STT_KEYTERMS=Sungrow,Sunbridger,BESS,PowerTitan,PowerStack,TNPDCL,single phase,three phase,iSolarCloud,PowerHarbor,WiNet,inverter,hybrid inverter,on-grid,kilowatt,MPPT,net metering,subsidy,Surya Ghar,KUSUM
# Mishearings seen in testing, fixed before the agent reads the caller's words ("wrong|other=Right; ...").
STT_CORRECTIONS=sunburger|sunbridge|sun bridge|sun bridger=Sunbridger; sun grown|sun grow|some grown|some grow|sunrow|sun row|sunroe|sunro|sunbro|sunbra|sunburo|sunbur|sunburn|sunroof=Sungrow

# Where this agent's call transcripts and messages are saved.
DATA_DIR=data/sungrow
