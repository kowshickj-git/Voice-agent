# Copy this file to .env and fill in your keys.
# The free setup below needs just one key: DEEPGRAM_API_KEY (free sign-up credit, no card).

# ── Required ───────────────────────────────────────────────────────────────
# Deepgram, for speech recognition and the voice: https://console.deepgram.com
DEEPGRAM_API_KEY=

# ── Phone calls (Twilio) ───────────────────────────────────────────────────
# Your Twilio auth token (Twilio Console > Account info). It's used to check
# that webhook requests really come from Twilio. Set it before going live.
TWILIO_AUTH_TOKEN=
# The public https address of this server, e.g. https://abc123.ngrok-free.app
# Optional: it's detected from each request when not set.
PUBLIC_URL=
PORT=8080

# ── Your agent ─────────────────────────────────────────────────────────────
AGENT_NAME=Ava
COMPANY_NAME=Sunrise Dental Clinic
# The first thing callers hear. Defaults to "Hi, thanks for calling <company>. This is <name>. How can I help you today?"
GREETING=
# Language the agent speaks, e.g. English, Spanish, Hindi. Use "auto" to reply in the caller's language
# (with STT_MODEL=flux-general-multi and a multilingual voice such as ElevenLabs).
AGENT_LANGUAGE=English
# Your local time zone, so the agent knows today's date and time: e.g. America/New_York, Europe/London, Asia/Kolkata
TIMEZONE=
# Optional: a subject the agent may also explain from general knowledge (e.g. "solar power").
# Empty: it answers only from agent/knowledge.md.
AGENT_EXPERTISE=
# Phone number for "transfer me to a person" (E.164 format, e.g. +14155550123). Leave empty to disable transfers.
TRANSFER_NUMBER=
# Optional: POST every message the agent takes to this URL (Slack incoming webhook, Zapier, Make, ...).
MESSAGE_WEBHOOK_URL=
# Optional: share the browser test phone through a tunnel. Visitors open https://<tunnel>/?key=<this>.
# At least 16 letters/digits; without it, the test phone only works on this computer.
WEB_ACCESS_KEY=

# ── The conversation model ─────────────────────────────────────────────────
# ollama:    free, runs on this computer (install https://ollama.com, then: ollama pull qwen3:4b-instruct)
# anthropic: Claude, the best conversation quality (paid API: https://platform.claude.com)
LLM_PROVIDER=ollama
# Leave empty for the default: qwen3:4b-instruct with Ollama, claude-opus-5-5 with Anthropic.
LLM_MODEL=
# Only for LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
# Claude's thinking effort: low keeps replies fast; medium or high for complex tasks (slower to respond).
LLM_EFFORT=low
# Only for LLM_PROVIDER=ollama: where Ollama runs, and the context window to use (tokens).
# Use 16384 for a large knowledge base like agents/sungrow, and the same value for every agent you
# run at once, so they share one loaded model (on 6 GB GPUs, see "Run more than one agent" in the README).
OLLAMA_URL=http://localhost:11434
LLM_CONTEXT_TOKENS=8192

# ── Speech recognition (Deepgram Flux) ─────────────────────────────────────
# flux-general-en (English) or flux-general-multi (multilingual, set STT_LANGUAGE_HINTS such as en,es,hi)
STT_MODEL=flux-general-en
STT_LANGUAGE_HINTS=
# Names and words the recognizer should expect, comma-separated, e.g. Sunrise Dental,Okafor,Invisalign
STT_KEYTERMS=
# Words it still gets wrong, fixed before the agent reads them: "wrong|other wrong=Right", groups separated by ";"
STT_CORRECTIONS=
# How sure Flux must be that the caller finished before the agent replies (0.5 to 0.9; higher waits longer).
STT_EOT_THRESHOLD=0.7
# Start preparing a reply early, when Flux is fairly sure the caller is done (faster replies). Empty disables.
STT_EAGER_EOT_THRESHOLD=0.5

# ── Voice (text-to-speech) ─────────────────────────────────────────────────
# deepgram (default, same key as above) or elevenlabs (more languages and voices)
TTS_PROVIDER=deepgram
# Deepgram Aura-2 voice, e.g. aura-2-thalia-en, aura-2-andromeda-en, aura-2-arcas-en, aura-2-celeste-es
DEEPGRAM_VOICE=aura-2-thalia-en
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 is the fastest; eleven_v4_turbo is more expressive
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Call behavior ──────────────────────────────────────────────────────────
# Seconds of caller silence before the agent checks in, how many check-ins before hanging up,
# and the maximum call length.
SILENCE_TIMEOUT_SECONDS=10
MAX_SILENCE_PROMPTS=2
MAX_CALL_MINUTES=20
# Where call transcripts and messages are saved
DATA_DIR=data
# debug shows per-reply timings and token usage
LOG_LEVEL=info
